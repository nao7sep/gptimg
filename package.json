{
  "name": "gptimg",
  "productName": "GptImg",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@12.2.0",
  "description": "Generate, edit and read images with OpenAI from TypeScript, then mask, compose and upscale them locally.",
  "license": "GPL-3.0-or-later",
  "author": {
    "name": "Yoshinao Inoguchi",
    "email": "yoshinao@inoguchi.com",
    "url": "https://github.com/nao7sep"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nao7sep/gptimg.git"
  },
  "type": "module",
  "workspaces": [
    "sdk"
  ],
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npm run typecheck && npm run typecheck -w gptimgsdk && vitest run",
    "test:full": "npm test && npm run test:live -w gptimgsdk",
    "check:release-tag": "node scripts/check-release-tag.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": false,
    "onnxruntime-node@1.30.0": true
  }
}
