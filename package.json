{
  "name": "gptimg",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@12.0.2",
  "description": "Generate, edit and read images with OpenAI from TypeScript, then mask, compose and upscale them locally.",
  "license": "GPL-3.0-or-later",
  "author": {
    "name": "Yoshinao Inoguchi",
    "email": "yoshinao@inoguchi.com",
    "url": "https://github.com/nao7sep"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nao7sep/gptimg.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "files": [
    "src"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "npm run typecheck && vitest run",
    "test:full": "npm test && vitest run --config vitest.live.config.ts",
    "check:package": "node scripts/check-package.mjs",
    "check:release-tag": "tsx scripts/check-release-tag.ts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@shockpkg/icon-encoder": "^3.2.3",
    "@types/node": "^26.6.4",
    "defu": "^6.1.7",
    "nanoid": "^6.0.2",
    "onnxruntime-node": "^1.29.0",
    "openai": "^7.30.0",
    "p-limit": "^7.3.3",
    "sharp": "^0.35.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.0.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": false,
    "onnxruntime-node@1.29.0": true
  }
}
