{
  "name": "gptimg",
  "productName": "GptImg",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@12.2.0",
  "description": "Make and edit images by chatting with OpenAI's models, and keep every conversation to pick up again later.",
  "license": "GPL-3.0-or-later",
  "author": {
    "name": "Yoshinao Inoguchi",
    "email": "yoshinao@inoguchi.com",
    "url": "https://github.com/nao7sep"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nao7sep/gptimg.git"
  },
  "type": "module",
  "main": "out/main/index.js",
  "workspaces": [
    "sdk"
  ],
  "engines": {
    "node": ">=24.12.0"
  },
  "config": {
    "devPort": 25793
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck:app && electron-vite build",
    "dist": "npm run build && electron-builder --publish never",
    "typecheck": "tsc -p tsconfig.node.json --noEmit --composite false && tsc -p tsconfig.web.json --noEmit --composite false && tsc -p tsconfig.test.json --noEmit --composite false",
    "typecheck:app": "tsc -p tsconfig.node.json --noEmit --composite false && tsc -p tsconfig.web.json --noEmit --composite false",
    "test": "npm run typecheck && npm run typecheck -w gptimgsdk && vitest run",
    "test:full": "npm test && npm run test:live -w gptimgsdk && npm run test:live",
    "check:release-tag": "node scripts/check-release-tag.ts",
    "test:live": "vitest run --config vitest.live.config.ts"
  },
  "dependencies": {
    "onnxruntime-node": "^1.30.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@babel/parser": "^7.29.9",
    "@shockpkg/icon-encoder": "^3.2.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "defu": "^6.1.7",
    "electron": "^44.9.0",
    "electron-builder": "^26.17.0",
    "electron-vite": "^6.0.0",
    "gptimgsdk": "*",
    "jsdom": "^30.1.2",
    "nanoid": "^6.0.2",
    "openai": "^7.32.0",
    "p-limit": "^7.3.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "zod": "^4.6.7"
  },
  "allowScripts": {
    "electron-winstaller@5.4.0": true,
    "fsevents@2.3.3": false,
    "onnxruntime-node@1.30.0": true
  }
}
