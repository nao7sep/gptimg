{
  "name": "gptimgsdk",
  "version": "0.1.0",
  "private": true,
  "description": "GptImg's SDK: generate, edit and read images with OpenAI, then mask, compose and upscale them locally.",
  "license": "GPL-3.0-or-later",
  "author": {
    "name": "Yoshinao Inoguchi",
    "email": "yoshinao@inoguchi.com",
    "url": "https://github.com/nao7sep"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nao7sep/gptimg.git",
    "directory": "sdk"
  },
  "type": "module",
  "engines": {
    "node": ">=24.12.0"
  },
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "test": "npm run typecheck && vitest run",
    "test:full": "npm test && npm run test:live",
    "test:live": "vitest run --config vitest.live.config.ts",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@shockpkg/icon-encoder": "^3.2.3",
    "defu": "^6.1.7",
    "nanoid": "^6.0.2",
    "onnxruntime-node": "^1.30.0",
    "openai": "^7.32.0",
    "p-limit": "^7.3.3",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@babel/parser": "^7.29.9",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.4",
    "fast-check": "^4.10.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": false,
    "onnxruntime-node@1.30.0": true
  }
}
